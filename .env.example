# GridrunnerAItrader — Environment Variables
# Copy this to .env, fill in your values, keep .env safe locally.
# On Render: paste the contents of your .env file into "Environment → Bulk Upload"

# === REQUIRED (secrets — fill these in) ===
API_SECRET=

# === OPTIONAL: Telegram Alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === SERVER ===
PORT=10000
